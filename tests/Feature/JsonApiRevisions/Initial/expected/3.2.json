{
    "openapi": "3.2.0",
    "info": {
        "title": "Scenario",
        "description": "Articles.\n\nNewer revisions:\n\n- 2026-12-01: Names become labels\n- 2027-01-15: Members replace writers",
        "version": "1.0.0"
    },
    "paths": {
        "/api/articles": {
            "get": {
                "tags": [
                    "Article"
                ],
                "summary": "List the articles.",
                "operationId": "articles.index",
                "parameters": [
                    {
                        "name": "include",
                        "in": "query",
                        "schema": {
                            "description": "Relationships to include, separated by commas: `writer`.",
                            "type": "string"
                        }
                    },
                    {
                        "name": "include_head",
                        "in": "query",
                        "schema": {
                            "description": "Relationships to include, separated by commas: `author`.",
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/vnd.api+json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "jsonapi",
                                        "data"
                                    ],
                                    "properties": {
                                        "jsonapi": {
                                            "$ref": "#/components/schemas/JsonApi"
                                        },
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Article"
                                            }
                                        },
                                        "included": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Writer"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    }
                }
            },
            "post": {
                "tags": [
                    "Article"
                ],
                "summary": "Create an article.",
                "operationId": "articles.store",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string"
                                    },
                                    "summary": {
                                        "type": [
                                            "string",
                                            "null"
                                        ],
                                        "maxLength": 100
                                    }
                                }
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Created",
                        "content": {
                            "application/vnd.api+json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "jsonapi",
                                        "data"
                                    ],
                                    "properties": {
                                        "jsonapi": {
                                            "$ref": "#/components/schemas/JsonApi"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/Article"
                                        },
                                        "included": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Writer"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationFailed"
                    }
                }
            }
        },
        "/api/articles/{post}": {
            "get": {
                "tags": [
                    "Article"
                ],
                "summary": "Show one article.",
                "operationId": "articles.show",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/vnd.api+json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "jsonapi",
                                        "data"
                                    ],
                                    "properties": {
                                        "jsonapi": {
                                            "$ref": "#/components/schemas/JsonApi"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/Article"
                                        },
                                        "included": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Writer"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            },
            "parameters": [
                {
                    "name": "post",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        },
        "/api/articles/{post}/preview": {
            "get": {
                "tags": [
                    "Article"
                ],
                "summary": "Preview one article.",
                "operationId": "articles.preview",
                "parameters": [
                    {
                        "name": "legacy",
                        "in": "query",
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/vnd.api+json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "jsonapi",
                                        "data"
                                    ],
                                    "properties": {
                                        "jsonapi": {
                                            "$ref": "#/components/schemas/JsonApi"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/Article"
                                        },
                                        "included": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Writer"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            },
            "parameters": [
                {
                    "name": "post",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        },
        "/api/members/{user}": {
            "get": {
                "tags": [
                    "Article"
                ],
                "summary": "Show one member: absent before Labels.",
                "operationId": "members.show",
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/vnd.api+json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "jsonapi",
                                        "data"
                                    ],
                                    "properties": {
                                        "jsonapi": {
                                            "$ref": "#/components/schemas/JsonApi"
                                        },
                                        "data": {
                                            "$ref": "#/components/schemas/Member"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "$ref": "#/components/responses/NotFound"
                    }
                }
            },
            "parameters": [
                {
                    "name": "user",
                    "in": "path",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    }
                }
            ]
        }
    },
    "components": {
        "schemas": {
            "Article": {
                "type": "object",
                "required": [
                    "type",
                    "id"
                ],
                "properties": {
                    "type": {
                        "const": "articles",
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "attributes": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            },
                            "status": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        }
                    },
                    "relationships": {
                        "type": "object",
                        "properties": {
                            "writer": {
                                "type": "object",
                                "properties": {
                                    "data": {
                                        "type": [
                                            "object",
                                            "null"
                                        ],
                                        "required": [
                                            "type",
                                            "id"
                                        ],
                                        "properties": {
                                            "type": {
                                                "const": "writers",
                                                "type": "string"
                                            },
                                            "id": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "JsonApi": {
                "type": "object",
                "required": [
                    "version"
                ],
                "properties": {
                    "version": {
                        "const": "1.1",
                        "type": "string"
                    }
                }
            },
            "Writer": {
                "type": "object",
                "required": [
                    "type",
                    "id"
                ],
                "properties": {
                    "type": {
                        "const": "writers",
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    },
                    "attributes": {
                        "type": "object",
                        "properties": {
                            "email": {
                                "type": [
                                    "string",
                                    "null"
                                ]
                            }
                        }
                    }
                }
            },
            "Member": {
                "type": "object",
                "required": [
                    "type",
                    "id"
                ],
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "id": {
                        "type": "string"
                    }
                }
            },
            "Error": {
                "type": "object",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                }
            },
            "ValidationError": {
                "type": "object",
                "required": [
                    "message",
                    "errors"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "object",
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "responses": {
            "NotFound": {
                "description": "Not Found",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Error"
                        }
                    }
                }
            },
            "ValidationFailed": {
                "description": "Validation failed",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ValidationError"
                        }
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "Article"
        }
    ]
}
