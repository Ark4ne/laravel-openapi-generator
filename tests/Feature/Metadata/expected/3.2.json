    "components": {
        "schemas": {
            "User": {
                "type": "object",
                "required": [
                    "id"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    }
                }
            },
            "Post": {
                "type": "object",
                "required": [
                    "id",
                    "position",
                    "rating",
                    "featured",
                    "status"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "position": {
                        "type": "integer"
                    },
                    "rating": {
                        "type": "number"
                    },
                    "featured": {
                        "type": "boolean"
                    },
                    "status": {
                        "type": "string"
                    }
                }
            },
            "Error": {
                "type": "object",
                "required": [
                    "message"
                ],
                "properties": {
                    "message": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "tags": [
        {
            "name": "User"
        },
        {
            "name": "users",
            "description": "Users of the API"
        },
        {
            "name": "accounts"
        },
        {
            "name": "admin",
            "summary": "Administration",
            "externalDocs": {
                "url": "https://example.com/admin"
            },
            "parent": "accounts",
            "kind": "nav"
        },
        {
            "name": "Report"
        }
    ]
}
