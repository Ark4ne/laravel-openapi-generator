{
    "$schema": "https://raw.githubusercontent.com/infection/infection/master/resources/schema.json",
    "source": {
        "directories": ["src"],
        // ark4ne/laravel-json-api 1.x and 2.x: mutated by infection.json5 and infection-json-api-v2.json5.
        "excludes": ["Integrations/JsonApi", "Integrations/JsonApiV2"]
    },
    "logs": {
        "text": "build/infection-json-api-v3/infection.log",
        "summary": "build/infection-json-api-v3/summary.log"
    },
    "tmpDir": "build/infection-json-api-v3",
    // Not looked up through `composer config bin-dir`, whose output deprecation notices can break.
    "phpUnit": {
        "customPath": "vendor/bin/phpunit"
    },
    "minMsi": 80,
    "minCoveredMsi": 80,
    // The tests of 3.x, without those of 1.x and 2.x.
    "testFrameworkOptions": "--exclude-group=json-api --exclude-group=json-api-v2 --exclude-group=benchmark",
    "mutators": {
        "@default": true
    }
}
