# Shared by phpstan.neon.dist (ark4ne/laravel-json-api 1.x, the dev dependency) and phpstan-json-api-v2.neon.dist
# (2.x): each leaves out the integration of the other line, whose classes are not installed.
includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpat/phpat/extension.neon
    - vendor/spaze/phpstan-disallowed-calls/extension.neon

parameters:
    level: max
    paths:
        - src
        - tests
        - bin
    tmpDir: build/phpstan
    excludePaths:
        # Deliberately odd PHPDoc read by the TypeResolver tests (unbound templates, non-generic parents…).
        - tests/Fixtures/Types/*
        # Declares in @throws the exceptions it documents, without throwing them.
        - tests/Fixtures/Responses/ResponseController.php
    ignoreErrors:
        # Description::copy() rebuilds the final subclass from its promoted properties, passed by name.
        -
            identifier: new.static
            path: src/Description/Description.php

    # Facades, global helpers and the container belong to src/Laravel/ (docs/architecture.md §2).
    disallowedNamespaces:
        -
            namespace: 'Illuminate\Support\Facades\*'
            message: 'facades are reserved to src/Laravel/: inject a Laravel contract instead'
            allowIn:
                - src/Laravel/*
                - tests/*
    disallowedFunctionCalls:
        -
            function:
                - 'app()'
                - 'resolve()'
                - 'config()'
                - 'request()'
                - 'response()'
                - 'env()'
                - 'trans()'
                - '__()'
                - 'storage_path()'
                - 'base_path()'
            message: 'global helpers are reserved to src/Laravel/: inject a dependency instead'
            allowIn:
                - src/Laravel/*
                - tests/*
        -
            function:
                - 'dd()'
                - 'dump()'
                - 'var_dump()'
                - 'print_r()'
                - 'ray()'
            message: 'debug output must not be committed'

    # The application renders its samples on the requests of the context: they carry the variant (docs/architecture.md §3.3).
    disallowedStaticCalls:
        -
            method: 'Symfony\Component\HttpFoundation\Request::create()'
            message: 'use GenerationContext::sampleRequest(), or prepare the request with GenerationContext::prepareRequest()'
            allowIn:
                - src/Context/GenerationContext.php
                - src/Extraction/Requests/RequestFactory.php
                - tests/*

services:
    -
        class: Ark4ne\OpenApi\Tests\Architecture\ArchitectureTest
        tags:
            - phpat.test
