includes:
    - phpstan.base.neon.dist

parameters:
    excludePaths:
        # ark4ne/laravel-json-api 2.x: analysed by phpstan-json-api-v2.neon.dist, with 2.x installed.
        - src/Integrations/JsonApiV2/*
        - tests/Unit/Integrations/JsonApiV2/*
        - tests/Feature/JsonApiV2/*
        - tests/Fixtures/JsonApiV2/*
